# Vercel ↔ Supabase Marketplace defaults (also work locally).
# https://supabase.com/docs/guides/integrations/vercel-marketplace

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Server-only secret key (never expose to the browser)
SUPABASE_SECRET_KEY=your-secret-key-here

# Database (used by npm run db:migrate). Vercel also sets POSTGRES_URL*.
POSTGRES_PASSWORD=your-database-password
# Optional full connection string (preferred when present):
# POSTGRES_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# POSTGRES_URL_NON_POOLING=...

# App-specific (not set by Supabase integration)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-strong-password
NEXT_PUBLIC_SITE_URL=http://localhost:3000
