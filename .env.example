# Leave these as placeholders (or set NEXT_PUBLIC_USE_LOCAL_STUB=true) to run
# against a local in-browser stub — no Supabase project required.
# To use a real project: set NEXT_PUBLIC_USE_LOCAL_STUB=false and fill in the
# values from Supabase Dashboard → Project Settings → API.

NEXT_PUBLIC_USE_LOCAL_STUB=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Absolute site origin for Open Graph / WhatsApp previews (no trailing slash).
# Example: https://metercalc.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
