# Leave these as placeholders (or set VITE_USE_LOCAL_STUB=true) to run
# against a local in-browser stub — no Supabase project required.
# To use a real project: set VITE_USE_LOCAL_STUB=false and fill in the values
# from Supabase Dashboard → Project Settings → API.

VITE_USE_LOCAL_STUB=true
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
