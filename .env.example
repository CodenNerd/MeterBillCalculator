# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-only: service role key (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database password (Dashboard → Settings → Database) — used by npm run db:migrate
SUPABASE_DB_PASSWORD=your-database-password

# Static superadmin login (server-only). Bootstrapped into Auth on first sign-in.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-strong-password

# Absolute site origin for Open Graph / WhatsApp previews (no trailing slash).
# Example: https://metercalc.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
